{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FlowStock.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/FlowStock.Api/bin/Debug/net10.0/FlowStock.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowStock.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5112"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
