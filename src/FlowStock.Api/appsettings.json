{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "FlowStock.Api"
    }
  },
  "ConnectionStrings": {
    "FlowStockDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Notifications": {
    "Scan": {
      "Enabled": true,
      "IntervalMinutes": 15,
      "InitialDelaySeconds": 30
    }
  },
  "Jwt": {
    "Issuer": "FlowStock",
    "Audience": "FlowStock.Api",
    "Key": "",
    "AccessTokenMinutes": 60
  },
  "AllowedHosts": "*"
}
